# 使用方式：复制本文件为 .env 并填入各平台 Key（.env 已被 git 忽略，不会上传）
# ── 主力对话模型（默认 DeepSeek，最便宜）─────────────────────────────
DEFAULT_PROVIDER=deepseek            # deepseek / zhipu / qwen / openai
DEEPSEEK_API_KEY=sk-你的key填这里
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-reasoner   # 深度思考默认；要更快可改 deepseek-chat

# ── 识图视觉桥（免费档优先）───────────────────────────────────────────
VISION_PROVIDER=zhipu                # zhipu / qwen
# 智谱：免费申请 https://open.bigmodel.cn （glm-4v-flash 免费档）
ZHIPU_API_KEY=你的智谱key
ZHIPU_VISION_MODEL=glm-4v-flash
# 通义 Qwen（备选）：阿里云百炼 https://bailian.console.aliyun.com 新用户免费额度
# DASHSCOPE_API_KEY=你的百炼key
# QWEN_VISION_MODEL=qwen-vl-plus

# ── OpenAI（可选，付费）──────────────────────────────────────────────
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Agent 单次任务最多执行几步（防死循环）
AGENT_MAX_ITERATIONS=10

# ── 联网搜索 ─────────────────────────────────────────────────
WEB_SEARCH_BACKEND=bing          # bing(免费,无需Key) / tavily(更稳,需Key)
# TAVILY_API_KEY=tvly-你的key     # 可选：https://tavily.com 免费申请
